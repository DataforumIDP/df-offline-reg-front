{
  "name": "registration.front",
  "version": "1.1.23-r",
  "type": "module",
  "author": {
    "name": "Dataforum",
    "email": "info@dataforum.pro",
    "url": "https://dataforum.pro"
  },
  "main": "dist-electron/main.js",
  "electronMain": "dist-electron/main.js",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "dev:electron": "concurrently \"cross-env PLATFORM=electron vite --port 3100 --mode electron\" \"wait-on http://localhost:3100 && cross-env NODE_ENV=development PLATFORM=electron electron ./dist-electron/main.js\"",
    "build": "tsc && vite build",
    "build:renderer": "vite build --mode electron",
    "build:electron": "tsc -p tsconfig.electron.json",
    "build:all": "yarn build:renderer && yarn build:electron",
    "dist": "yarn build:all && electron-builder",
    "dist:win": "npx cross-env UPDATE_SERVER_URL=https://e8c490b0-8f86-49e6-b849-57f0230dd8a5.selstorage.ru/windows/ yarn build:all && electron-builder --win --config ./build_win.cjs",
    "dist:linux": "powershell -ExecutionPolicy Bypass -File ./dist-linux.ps1",
    "preview": "vite preview",
    "lint": "eslint . --ext .ts,.tsx",
    "lint:fix": "eslint . --ext .ts,.tsx --fix",
    "format": "prettier --write \"src/**/*.{ts,tsx,js,jsx,json,css,md}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,js,jsx,json,css,md}\"",
    "prepare": "husky",
    "version:bump": "node scripts/version-bump.cjs"
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.0",
