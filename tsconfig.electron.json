{
    "compilerOptions": {
        "module": "ES2022",
        "moduleResolution": "bundler",
        "target": "ES2022",
        "esModuleInterop": true,
        "forceConsistentCasingInFileNames": true,
        "allowSyntheticDefaultImports": true,
        "strict": true,
        "skipLibCheck": true,
        "outDir": "./dist-electron",
        "rootDir": "./electron",
        "resolveJsonModule": true,
        "declaration": false,
        "sourceMap": true,
        "types": ["node"]
    },
    "include": ["electron/**/*"],
    "exclude": ["node_modules", "dist", "dist-electron"]
}
